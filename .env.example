# secret ของ Worker ตัวนี้
#
# ไฟล์นี้เป็น **ตัวอย่าง** ไม่มีค่าจริง และไม่ใช่ไฟล์ที่ Worker อ่านตอนรัน
# มีไว้สองอย่าง
#
#   1. ปุ่ม Deploy to Cloudflare อ่านไฟล์นี้แล้วถามค่าทีละตัวในหน้า dashboard
#      ตอน deploy — คำอธิบายของแต่ละตัวอยู่ใน package.json ใต้ `cloudflare.bindings`
#   2. คนที่ deploy ด้วยมือใช้เป็นรายการว่าต้องตั้งอะไรบ้าง ด้วย
#      `npx wrangler secret put <ชื่อ>`
#
# **ห้ามใช้ค่าที่มีอักขระ + / =** เช่นที่ได้จาก base64 เพราะ query string ตีความ
# อักขระพวกนั้น (`+` กลายเป็นช่องว่าง) รหัสที่ส่งไปจะไม่ตรงกับที่ตั้งไว้โดยไม่มี
# อะไรฟ้อง ใช้ hex ล้วนตามคำสั่งในแต่ละบรรทัด
#
# เตือนสำหรับคนที่ตั้งเอง: `wrangler secret put` เขียนทับค่าเดิมทันทีโดยไม่ถามและ
# ย้อนไม่ได้ พิมพ์ชื่อผิดไปตัวเดียวของเดิมก็หาย — ยิงทดสอบทุกครั้งหลังตั้ง

# จำเป็น — ไม่มีค่านี้ server ปฏิเสธทุกคำขอที่ /mcp
# openssl rand -hex 32
MCP_AUTH_TOKEN=

# ไม่บังคับ — รหัสที่พิสูจน์ว่าคนอยู่ตรงนั้นจริงตอนปิด decision
# ห้ามใส่ในเครื่องมือของ AI ตัวไหน ไม่ตั้ง = ทุกการปิดถูกบันทึกเป็น relayed
# openssl rand -hex 24
APPROVAL_SECRET=

# ไม่บังคับ — รหัสของหน้าอ่านอย่างเดียวที่ /view
# ไม่ตั้ง = ไม่มีหน้านั้น ไม่ใช่เปิดโล่ง
# openssl rand -hex 24
VIEW_TOKEN=

# ไม่บังคับ — โทเคนหลายใบผูกชื่อไว้กับแต่ละใบ `token=ชื่อ` คั่นด้วย comma
# ชื่อจากโทเคนชนะ X-Client-Name เสมอ อย่าใช้กับ client ที่ตั้ง header เองได้
MCP_AUTH_TOKENS=
